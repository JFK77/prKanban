rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Demo-only rule: allow the Kanban app to read and write task data.
    // For production, replace this with auth-based access control.
    match /tasks/{taskId} {
      allow read, write: if true;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
